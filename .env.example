# SocialSphere Root Environment Example
# See individual client/.env.example, server/.env.example, and socket/.env.example for details

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/socialsphere?retryWrites=true&w=majority
JWTKEY=your_super_secret_jwt_key_here
FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:8800
