# Database Configuration
# Replace with your MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/socialsphere?retryWrites=true&w=majority

# JWT Authentication
# Strong random secret key (e.g. generated via `openssl rand -hex 64`)
JWTKEY=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1h

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Rate Limiting
API_RATE_LIMIT=500

# Logging
LOG_LEVEL=info

# Socket Server (Optional external socket URL)
SOCKET_SERVER_URL=http://localhost:8800
