{
  "name": "socialsphere",
  "version": "1.0.0",
  "description": "Social media application",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "install-server": "cd server && npm install",
    "install-socket": "cd socket && npm install",
    "install-client": "cd client && npm install",
    "install-all": "npm run install-server && npm run install-socket && npm run install-client",
    "start-server": "cd server && node index.js",
    "start-socket": "cd socket && npm start",
    "start-client": "cd client && npm start",
    "validate-env": "node validate-env.js",
    "generate-jwt": "node generate-jwt-key.js",
    "test-db": "cd server && node test-db-connection.js",
    "cleanup-followers": "cd server && node cleanup-followers.js",
    "build": "npm run install-all"
  },
  "author": "",
  "license": "ISC"
}
